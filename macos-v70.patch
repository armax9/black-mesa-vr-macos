+    static void ReadStackDwords(DWORD esp, DWORD* out, int count)
+    {
+        for (int i = 0; i < count; ++i)
+            out[i] = 0;
+        if (esp < 0x10000)
+            return;
+        const DWORD* stk = reinterpret_cast<const DWORD*>(static_cast<uintptr_t>(esp));
+        for (int i = 0; i < count; ++i)
