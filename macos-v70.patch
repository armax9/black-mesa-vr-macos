+                + (2.f * p0 - 5.f * p1 + 4.f * p2 - p3) * t2
+                + (-p0 + 3.f * p1 - 3.f * p2 + p3) * t3);
+        };
+        for (int y = 0; y < nh; ++y)
+        {
+            const float fy = (static_cast<float>(y) + 0.5f) * sy - 0.5f;
+            const int y1 = static_cast<int>(floorf(fy));
+            const float ty = fy - static_cast<float>(y1);
+            for (int x = 0; x < nw; ++x)
